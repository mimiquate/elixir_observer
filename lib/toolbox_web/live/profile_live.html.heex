<article
  class={"pt-3 sm:pt-10 #{if(@packages == [] and @api_keys == [], do: "h-full")}"}
  {test_attrs(profile_page: true)}
>
  <div {test_attrs(profile_page_header: true)}>
    <h1
      class="text-[42px] sm:text-[64px] text-primary-text font-semibold font-serif break-all"
      {test_attrs(profile_page_title: true)}
    >
      Profile
    </h1>

    <p class="text-[14px] sm:text-[18px] font-mono text-secondary-text">
      This is your personal space on Observer.
    </p>
  </div>

  <div class="flex items-center justify-between mt-8 mb-3 sm:mb-8">
    <h2 class="text-[20px] text-primary-text sm:text-[32px] font-semibold">
      Followed packages
    </h2>
  </div>

  <%= if Enum.any?(@packages) do %>
    <div class="mt-6 sm:mt-8" {test_attrs(profile_packages: true)}>
      <ToolboxWeb.Components.PackageList.package_list packages={@packages} />
    </div>
  <% else %>
    <div class="flex flex-col items-center">
      <img src={~p"/images/empty-state-figure.png"} />
      <h3 class="text-primary-text sm:text-[24px] mt-3" {test_attrs(no_packages_title: true)}>
        No packages yet
      </h3>
      <p class="text-secondary-text sm:text-[16px]" {test_attrs(no_packages_message: true)}>
        Start following packages to see them here
      </p>
    </div>
  <% end %>

  <div class="mt-12 sm:mt-16 mb-3 sm:mb-8">
    <div class="flex items-center justify-between">
      <h2 class="text-[20px] text-primary-text sm:text-[32px] font-semibold">
        API Keys
      </h2>

      <.button
        type="button"
        class="cursor-pointer"
        phx-click="open_api_key_modal"
        {test_attrs(create_api_key_button: true)}
      >
        Create API key
      </.button>
    </div>

    <p class="mt-3 text-[14px] text-secondary-text">
      Generate and manage API keys to connect Observer with external tools and AI assistants.
    </p>
  </div>

  <%= if Enum.any?(@api_keys) do %>
    <div class="mt-6 sm:mt-8" {test_attrs(profile_api_keys: true)}>
      <ToolboxWeb.Components.ApiKeyList.api_key_list api_keys={@api_keys} />
    </div>
  <% else %>
    <div class="flex flex-col items-center">
      <img src={~p"/images/empty-state-figure-new.png"} />
      <div class="mt-3 flex flex-col items-center gap-4 text-center">
        <h3 class="text-lg font-medium text-primary-text" {test_attrs(no_api_keys_title: true)}>
          No API Keys created yet
        </h3>
        <p class="text-sm text-secondary-text" {test_attrs(no_api_keys_message: true)}>
          Click Create API key to generate your first key and start connecting Observer with external tools and AI assistants.
        </p>
      </div>
    </div>
  <% end %>

  <ToolboxWeb.Components.ApiKeyModal.api_key_modal
    :if={@api_key_form}
    form={@api_key_form}
    created_api_key={@created_api_key}
    token={@created_api_key_token}
  />
</article>
